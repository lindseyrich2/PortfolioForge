# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class

# --- C extensions ---
*.so
*.pyd

# --- Packaging / build artifacts ---
build/
dist/
*.egg-info/
.eggs/
*.egg
wheels/
pip-wheel-metadata/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

